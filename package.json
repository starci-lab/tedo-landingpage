{
  "name": "tedo-landing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "starci": {
    "deliveryAssurance": {
      "required": true,
      "unitCoverage": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 75,
        "patch": 90
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "npm run lint:check",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "npm test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:coverage && npm run coverage:patch",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600",
    "coverage:patch": "node scripts/check-coverage-change.mjs",
    "secret:set": "node scripts/stack-secret.mjs set",
    "secret:list": "node scripts/stack-secret.mjs list"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@swc/helpers": "^0.5.23",
    "framer-motion": "^12.42.2",
    "next": "^15.5.21",
    "next-intl": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "^1.3.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
