# Optional delivery target for the legacy contact form.
CONTACT_WEBHOOK_URL=

# Private server-to-server origin for the durable consultation backend.
# Never prefix with NEXT_PUBLIC_; browsers only call same-origin /api routes.
TEDO_BACKEND_URL=http://127.0.0.1:3030

# Public origin used for metadata and deployment checks.
SITE_URL=http://localhost:3020

# Public Zalo OA link shown after a lead chooses Zalo follow-up.
NEXT_PUBLIC_ZALO_OA_URL=
