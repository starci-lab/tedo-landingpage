# Where the contact form forwards leads (Slack/Discord webhook, Zapier, n8n, or
# your own endpoint). Until this is set, /api/contact returns 501 and the form
# tells visitors to email directly — by design, so no lead is silently dropped.
CONTACT_WEBHOOK_URL=

# --- AI quote chatbot (/api/chat) ---
# OpenRouter API key. SERVER-ONLY — never prefix with NEXT_PUBLIC_, or it leaks
# to the browser. Get one at https://openrouter.ai/keys. Until this is set,
# /api/chat returns 503 and the chat widget shows a "chưa bật" notice.
OPENROUTER_API_KEY=

# Model slug on OpenRouter. Confirm the exact id on https://openrouter.ai/models
# (defaults to deepseek/deepseek-v4-flash if unset).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Public site URL, sent to OpenRouter as the HTTP-Referer attribution header.
SITE_URL=http://localhost:3020
